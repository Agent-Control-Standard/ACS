{
  "_comment": [
    "Drop into ~/.claude/settings.json (or merge with your existing config).",
    "Prefer generating this with wire.py, which validates hook coverage and",
    "warns when a subset of the ACS-Core minimum is wired — this file was",
    "produced to match wire.py's output (PR #22 review: the previous",
    "hand-written example wired 5 hooks and missed Notification, failing",
    "the Core minimum it claimed).",
    "",
    "Replace ACS_GUARDIAN_URL with your deployment's endpoint.",
    "",
    "ACS_HMAC_SECRET_FILE: REQUIRED for ACS-Core baseline integrity (§10).",
    "Without a secret both ends run unsigned and any local process that",
    "binds the Guardian port first becomes the Guardian. Generate one:",
    "  mkdir -p ~/.acs && openssl rand -hex 32 > ~/.acs/hmac.key && chmod 600 ~/.acs/hmac.key",
    "and give the SAME file to the Guardian.",
    "",
    "ACS_AUDIT_FILE: where §6.4 audit events land durably. Hook-process",
    "stderr is collected by nothing; this file is the audit half of the",
    "fail-open trade.",
    "",
    "ACS_DEFAULT_DENY=1 is set on the GATE hooks (PreToolUse,",
    "UserPromptSubmit — the ones whose verdict blocks an action, per",
    "wire.py GATE_HOOKS). Observational hooks fail open per the §6.4",
    "default. Incident kill switch: set ACS_DISABLED=1 to bypass all",
    "hooks immediately."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log",
              "ACS_DEFAULT_DENY": "1"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log",
              "ACS_DEFAULT_DENY": "1"
            }
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/acs_adapter.py",
            "env": {
              "ACS_GUARDIAN_URL": "http://127.0.0.1:8787/acs",
              "ACS_HMAC_SECRET_FILE": "/path/to/.acs/hmac.key",
              "ACS_AUDIT_FILE": "/path/to/.acs/audit.log"
            }
          }
        ]
      }
    ]
  }
}
